{
    "openapi": "3.0.0",
    "info": {
        "title": "Reconcile AI Apis",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User login",
                "description": "Authenticates a user and returns a JWT token",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "test@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login Success"
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "example": "John Doe"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "example": "test@example.com"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "token": {
                                                    "type": "string",
                                                    "example": "eyJhbGciOiJIUzI1NiIsInR..."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 401
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid credentials"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Login failed due to validation error or server issue",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 400
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login Failed"
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Invalid email format"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1": {
            "get": {
                "tags": [
                    "Home"
                ],
                "summary": "Home Endpoint",
                "description": "Welcome message or API overview",
                "operationId": "a86d5eefc2bb09a10d67b99b5403d49e",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Welcome to the API"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/reconcile": {
            "post": {
                "tags": [
                    "Reconciliation"
                ],
                "summary": "Reconcile two CSV files",
                "description": "Uploads two CSV files and returns reconciled records.",
                "operationId": "47cda2733290d3ed5e6ef36ed538bbd2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "bank_statement",
                                    "company_ledger"
                                ],
                                "properties": {
                                    "bank_statement": {
                                        "description": "First CSV file",
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "company_ledger": {
                                        "description": "Second CSV file",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reconciliation successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "description": "Response message",
                                            "type": "string"
                                        },
                                        "status": {
                                            "description": "Response status",
                                            "type": "string"
                                        },
                                        "status_code": {
                                            "description": "Response status code",
                                            "type": "integer"
                                        },
                                        "data": {
                                            "properties": {
                                                "reconciliationSummary": {
                                                    "description": "Summary of reconciliation results",
                                                    "properties": {
                                                        "totalMatchedTransactions": {
                                                            "description": "Number of matched transactions",
                                                            "type": "integer"
                                                        },
                                                        "totalUnmatchedTransactions": {
                                                            "description": "Number of unmatched transactions",
                                                            "type": "integer"
                                                        },
                                                        "accuracyRate": {
                                                            "description": "Percentage of accuracy",
                                                            "type": "number",
                                                            "format": "float"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "matchedTransactions": {
                                                    "description": "List of matched transactions",
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "bank_statement": {
                                                                "description": "Transaction data from bank statement",
                                                                "type": "object",
                                                                "example": {
                                                                    "Date": "2025-01-01",
                                                                    "Description": "Payment",
                                                                    "Amount": 1000
                                                                }
                                                            },
                                                            "company_ledger": {
                                                                "description": "Transaction data from company ledger",
                                                                "type": "object",
                                                                "example": {
                                                                    "Date": "2025-01-01",
                                                                    "Description": "Payment",
                                                                    "Amount": 1000
                                                                }
                                                            },
                                                            "status": {
                                                                "description": "Match status",
                                                                "type": "string",
                                                                "example": "matched"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation or processing error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "description": "Error message",
                                            "type": "string"
                                        },
                                        "errors": {
                                            "description": "Detailed validation errors",
                                            "type": "object",
                                            "example": {
                                                "bank_statement": [
                                                    "The bank statement file is required."
                                                ],
                                                "company_ledger": [
                                                    "The company ledger file is required."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/wait-list": {
            "post": {
                "tags": [
                    "WaitList"
                ],
                "summary": "Add email to waitlist",
                "description": "Adds a new email address to the wait list",
                "operationId": "b186c1247e260332911484977fad8abb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "description": "Email address to add to waitlist",
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successfully joined wait list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Successfully joined wait list"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Email is required"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Home",
            "description": "Home"
        },
        {
            "name": "Reconciliation",
            "description": "Reconciliation"
        },
        {
            "name": "WaitList",
            "description": "WaitList"
        }
    ]
}
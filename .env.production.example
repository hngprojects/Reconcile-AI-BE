APP_NAME=ReconXi
APP_ENV=production
APP_KEY=base64:your-production-key-here
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=reconxi_prod
DB_USERNAME=reconxi_prod
DB_PASSWORD=your-secure-password

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache Configuration
CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=reconxi_prod_cache

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIES=true

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Broadcasting Configuration
BROADCAST_CONNECTION=redis

# Filesystem Configuration
FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_TTL=10080

# API Keys (use environment-specific keys)
GEMINI_API_KEY=your-production-gemini-key
OPENAI_API_KEY=your-production-openai-key

# Google OAuth (production credentials)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback

# Swagger Configuration
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_API_VERSION=1.0.0
L5_SWAGGER_TITLE="Reconcile AI"
L5_SWAGGER_DESCRIPTION="API documentation for Reconcile AI application"
L5_SWAGGER_BASE_PATH="/"

# Reverb WebSocket Configuration
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https